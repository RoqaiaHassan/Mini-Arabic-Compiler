برنامج اختبارشامل؛
ثابت
    خمسة = 5؛
    اثنان = 2؛
نوع
    ارقام = قائمة [5] من صحيح؛
    شخص = سجل
    {
        عمر : صحيح؛
        ناجح : منطقي؛
    }؛
متغير
    س, ص, ن, ع, ب, ر, فوه : صحيح؛
    ف : ارقام؛
    ش : شخص؛
    عداد : صحيح؛

إجراء زيادة(بالمرجع قيمة : صحيح, بالقيمة مقدار : صحيح)
{
    قيمة = قيمة + مقدار؛
}

{
    س = 2 + 3 * 4؛
    ص = س + خمسة؛
    ن = 20 - 1؛
    ع = 19 / 2؛
    ب = 17 \ 5؛
    ر = 17 % 5؛
    فوه = 2 ^ 3؛

    إذا (س > 0 و ص > 0) فإن
    {
        اطبع("اقل من عشرة")؛
        اطبع(فوه)؛
    }

    لكل عداد = 1 إلى 3 بقدر 1
    {
        اطبع("رقم التكرار", عداد)؛
    }

    ف[0] = ن؛
    ف[1] = ب؛
    ف[2] = ر؛
    ف[3] = فوه؛
    ف[4] = ف[0] + ف[3]؛

    ش.عمر = ف[4]؛
    ش.ناجح = نعم؛

    زيادة(س, 1)؛

    اطبع("قيمة ص", ص)؛
    اطبع("قيمة ن", ن)؛
    اطبع("القسمة الحقيقية", ع)؛
    اطبع("القسمة الصحيحة", ب)؛
    اطبع("باقي القسمة", ر)؛
    اطبع("الاس", فوه)؛
    اطبع("العنصر صفر", ف[0])؛
    اطبع("العنصر الرابع", ف[4])؛
    اطبع("عمر الشخص", ش.عمر)؛
    اطبع("حالة الشخص", ش.ناجح)؛
    اطبع("القيمة النهائية لس", س)؛
}.
